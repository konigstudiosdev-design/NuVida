rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Organization Files Storage Security Rules
    match /organizations/{orgId}/{allPaths=**} {
      // Allow read/write only if the user belongs to this organization
      allow read, write: if isAuthenticated() && request.auth.token.organizationId == orgId;
    }

    // Patient Photos & Documents
    match /organizations/{orgId}/patients/{patientId}/{fileName} {
      allow read: if isAuthenticated() && (
        request.auth.token.organizationId == orgId &&
        (request.auth.token.role == 'nutriologo' || request.auth.token.patientId == patientId)
      );
      allow write: if isAuthenticated() && request.auth.token.organizationId == orgId && request.auth.token.role == 'nutriologo';
    }
  }
}
